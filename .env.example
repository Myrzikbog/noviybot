# Токен Telegram бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# API ключ Google Gemini от Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (рекомендуется gemini-2.5-flash или gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash
